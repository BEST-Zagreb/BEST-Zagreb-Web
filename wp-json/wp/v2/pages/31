ing:0;margin:0;line-height:1}.elementor-widget-heading .elementor-heading-title[class*=elementor-size-]>a{color:inherit;font-size:inherit;line-height:inherit}.elementor-widget-heading .elementor-heading-title.elementor-size-small{font-size:15px}.elementor-widget-heading .elementor-heading-title.elementor-size-medium{font-size:19px}.elementor-widget-heading .elementor-heading-title.elementor-size-large{font-size:29px}.elementor-widget-heading .elementor-heading-title.elementor-size-xl{font-size:39px}.elementor-widget-heading .elementor-heading-title.elementor-size-xxl{font-size:59px}<\/style><h2 class=\"elementor-heading-title elementor-size-default\">BEST Stru\u010dni seminari<\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<div class=\"elementor-element elementor-element-1724319 elementor-widget elementor-widget-accordion\" data-id=\"1724319\" data-element_type=\"widget\" data-widget_type=\"accordion.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<style>\/*! elementor - v3.10.0 - 09-01-2023 *\/\n.elementor-accordion{text-align:left}.elementor-accordion .elementor-accordion-item{border:1px solid #d4d4d4}.elementor-accordion .elementor-accordion-item+.elementor-accordion-item{border-top:none}.elementor-accordion .elementor-tab-title{margin:0;padding:15px 20px;font-weight:700;line-height:1;cursor:pointer;outline:none}.elementor-accordion .elementor-tab-title .elementor-accordion-icon{display:inline-block;width:1.5em}.elementor-accordion .elementor-tab-title .elementor-accordion-icon svg{width:1em;height:1em}.elementor-accordion .elementor-tab-title .elementor-accordion-icon.elementor-accordion-icon-right{float:right;text-align:right}.elementor-accordion .elementor-tab-title .elementor-accordion-icon.elementor-accordion-icon-left{float:left;text-align:left}.elementor-accordion .elementor-tab-title .elementor-accordion-icon .elementor-accordion-icon-closed{display:block}.elementor-accordion .elementor-tab-title .elementor-accordion-icon .elementor-accordion-icon-opened,.elementor-accordion .elementor-tab-title.elementor-active .elementor-accordion-icon-closed{display:none}.elementor-accordion .elementor-tab-title.elementor-active .elementor-accordion-icon-opened{display:block}.elementor-accordion .elementor-tab-content{display:none;padding:15px 20px;border-top:1px solid #d4d4d4}@media (max-width:767px){.elementor-accordion .elementor-tab-title{padding:12px 15px}.elementor-accordion .elementor-tab-title .elementor-accordion-icon{width:1.2em}.elementor-accordion .elementor-tab-content{padding:7px 15px}}.e-con-inner>.elementor-widget-accordion,.e-con>.elementor-widget-accordion{width:var(--container-widget-width);--flex-grow:var(--container-widget-flex-grow)}<\/style>\t\t<div class=\"elementor-accordion\" role=\"tablist\">\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<div id=\"elementor-tab-title-2421\" class=\"elementor-tab-title\" data-tab=\"1\" role=\"tab\" aria-controls=\"elementor-tab-content-2421\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-left\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"><\/i><\/span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"><\/i><\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" href=\"\">Op\u0107enito o BEST-ovim seminarima<\/a>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t<div id=\"elementor-tab-content-2421\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"1\" role=\"tabpanel\" aria-labelledby=\"elementor-tab-title-2421\"><p><b>Odr\u017eavaju li se seminari kroz cijelu godinu?<\/b><\/p><p>Da, seminari se odr\u017eavaju kroz \u010detiri sezone &#8211; godi\u0161nja doba (prolje\u0107e, ljeto, jesen i zima) te se studenti mogu prijaviti na seminare u sezoni koja trenutno traje.<\/p><p>\u00a0<\/p><p><b>Koliko traju?<\/b><br \/>Seminari traju izme\u0111u 7 i 14 dana.<\/p><p><b>Gdje se odr\u017eavaju?<\/b><br \/>Svaka lokalna BEST grupa mora odr\u017eati seminar jednom godi\u0161nje, tako da u razli\u010ditim sezonama, doma\u0107ini seminara su razli\u010diti gradovi Europe. Listu seminara u trenutnoj sezoni mo\u017ee\u0161 prona\u0107i na:\u00a0<a class=\"broken_link\" href=\"https:\/\/best.eu.org\/courses\/list.jsp\">Lista Seminara<\/a>.<\/p><p><b>Koja je tema seminara?<\/b><br \/>Postoje 3 tipa\u00a0seminara:<\/p><ul><li>BEST Course on Technology,\u00a0<\/li><li>BEST Course on Career Related Skills\u00a0i\u00a0<\/li><li>BEST Course on Applied Engineering<\/li><\/ul><p>Teme seminara su naj\u010de\u0161\u0107e tehni\u010dke i tehnolo\u0161ke tematike te ovise o lokalnoj grupi koja ga organizira.<\/p><p>\u00a0<\/p><p><b>Ima li jo\u0161 kakvih doga\u0111anja osim seminara?<\/b><br \/>BEST za studente organizira i\u00a0BEST Symposia on Education\u00a0te\u00a0BEST Engineering Competition\u00a0za koja vrijede sli\u010dna pravila.<b><\/b><\/p><p><b>\u0160to je \u201cBEST Symposia on Education\u201d?<\/b><br \/>BEST Simpozij o obrazovanju je doga\u0111aj na kojem studenti, lokalni i internacionalni profesori, stru\u010dnjaci iz razli\u010ditih industrijskih i znanstvenih organizacija, predstavnici sveu\u010dili\u0161ta te kompanija raspravljaju o obrazovnom sustavu i na\u010dinima kako ga pobolj\u0161ati.\u00a0Sami oblik doga\u0111aja i sva pravila su identi\u010dni kao kod BEST Courses, jedina razlika je u tematici.<b><\/b><\/p><p><b>\u0160to su \u201cBEST Courses\u201d?<\/b><br \/>Na BEST-ovim seminarima studenti slu\u0161aju predavanja sveu\u010dili\u0161nih profesora ili stru\u010dnjaka iz tvrtki. \u010cesti su i sami posjeti tvrtkama te rad u laboratoriju. S obzirom da po zavr\u0161etku seminara studenti pola\u017eu i ispit, mogu dobiti ECTS bodove (ispit mo\u017ee biti pismeni, usmeni ili grupna prezentacija).<b><\/b><\/p><p><b>Kolika je cijena seminara?<\/b><br \/>Za svaki seminar je odre\u0111ena druga\u010dija cijena i ta cijena se jasno navodi za svaki seminar u kategoriji \u2018fee\u2019. Cijena koju studenti iz Hrvatske pla\u0107aju iznosi oko 40% navedene cijene (postotak se odre\u0111uje prema visini BDP-a odre\u0111ene dr\u017eave), odnosno maksimalni iznos od 20\u20ac.<b><\/b><\/p><p><b>Za\u0161to je cijena seminara tako niska?<\/b><br \/>BEST \u017eeli omogu\u0107iti \u0161to \u0161iroj populaciji studenata sudjelovanje na ovim doga\u0111anjima te zbog toga organizatori imaju du\u017enost sakupiti financije na drugi na\u010din. Zbog toga podru\u017enice BEST-a ostvaruju suradnju s tvrtkama, sveu\u010dili\u0161tima i ostalim institucijama koje na razne na\u010dine podupiru organizaciju ovih doga\u0111anja.<b><\/b><\/p><p><b>Imam prijatelja, mo\u017eemo li mi skupa na seminar? \u2013 alternativa [Mo\u017eemo li prijatelj i ja zajedno na seminar?]<\/b><br \/>U ve\u0107ini slu\u010dajeva ovakav scenarij je gotovo neostvariv. Naime, organizatori seminara obi\u010dno biraju studente iz razli\u010ditih zemalja kako bi ostvarili \u0161to ve\u0107u raznolikost me\u0111u studentima.<b><\/b><\/p><p><b>Moram li imati visoki prosjek kako bih mogao sudjelovati na seminarima? \u2013 [Utje\u010de li moj prosjek ocjena na prijavu?]<\/b><br \/>Apsolutno ne. Kod biranja sudionika koristimo druge kriterije, a same teme seminara ve\u0107inom zahtijevaju samo osnovno poznavanje tematike.<b><\/b><\/p><p><b>Moram li znati engleski jezik?<\/b><br \/>Da, znanje engleskog jezika je obavezno. Sva komunikacija te predavanja odvijaju se na engleskom jeziku.<b><\/b><\/p><p><b>\u0160to je uklju\u010deno u cijenu seminara?<\/b><br \/>U cijenu seminara uklju\u010dene su sve obavezne aktivnosti, smje\u0161taj i hrana.\u00a0U cijenu ne ulaze tro\u0161kovi puta.<b><\/b><\/p><p><b>Koji su kriteriji odabira sudionika?<\/b><br \/>Motivacijsko pismo te odgovori na 3 jednostavna pitanja. Organizatori biraju sudionike po subjektivnoj procjeni te pismo mora biti kreativno i domi\u0161ljato. Kod odabira sudionika tako\u0111er se obra\u0107a pozornost da studenti budu iz \u0161to vi\u0161e razli\u010ditih zemalja te da bude podjednak broj mu\u0161kih i \u017eenskih sudionika.<\/p><\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<div id=\"elementor-tab-title-2422\" class=\"elementor-tab-title\" data-tab=\"2\" role=\"tab\" aria-controls=\"elementor-tab-content-2422\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-left\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"><\/i><\/span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"><\/i><\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" href=\"\">Prijava na seminare<\/a>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t<div id=\"elementor-tab-content-2422\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"2\" role=\"tabpanel\" aria-labelledby=\"elementor-tab-title-2422\"><p><b>Tko se mo\u017ee prijaviti?<\/b><br \/>Svi studenti Sveu\u010dili\u0161ta u Zagrebu imaju mogu\u0107nost prijave na BEST seminare. Seminari su namijenjeni studentima tehni\u010dkih i tehnolo\u0161kih fakulteta, no i ostali studenti sa Sveu\u010dili\u0161ta imaju pravo na prijavu.<\/p><p>\u00a0<\/p><p><b>Moram li biti \u010dlan BEST-a da bih se prijavio?<\/b><br \/>Ne.<b><\/b><\/p><p><b>Kako se registrirati za prijavu?<\/b><br \/>Upute mo\u017ee\u0161 pro\u010ditati na stranici:\u00a0<a class=\"broken_link\" href=\"https:\/\/web.archive.org\/web\/20220927133431\/https:\/\/best.eu.org\/courses\/welcome.jsp\">https:\/\/best.eu.org\/courses\/welcome.jsp<\/a>\u00a0ili posjetiti jednu od na\u0161ih radionica pisanja motivacijskih pisama.<b><\/b><\/p><p><b>Kako \u0107u znati kada se mogu prijavljivati za seminare?<\/b><br \/>Obavijesti o otvorenim prijavama objavljujemo na dru\u0161tvenim mre\u017eama te stranicama fakulteta.<b><\/b><\/p><p><b>\u0160to je to \u2018fee\u2019?<\/b><br \/>Cijena seminara koju svaki primljeni student mora platiti za prisustvovanje na seminaru. Hrvatski studenti pla\u0107aju oko 40% navedene cijene, \u0161to u praksi iznosi maksimalno 20\u20ac.<b><\/b><\/p><p><b>\u0160to je to \u2018deposit\u2019?<\/b><br \/>Polog koji studenti primljeni na seminar ostavljaju kao potvrdu da \u0107e oti\u0107i na seminar. Studenti polog dobivaju natrag nakon \u0161to se vrate sa seminara ako su ispunili sve unaprijed dogovorene obveze (prisustvovali na svim predavanjima, ispunili upitnik o seminaru&#8230;).<b><\/b><\/p><p><b>\u0160to je \u2018motivation letter\u2019?<\/b><br \/>Motivacijsko pismo u kojem izra\u017eava\u0161 svoju motivaciju za sudjelovanje na odre\u0111enom seminaru. U pismu je cilj predstaviti sebe te napisati za\u0161to \u017eeli\u0161 posjetiti ba\u0161 taj seminar. Ovo pismo je ujedno i jedini kriterij po kojemu se biraju sudionici seminara. Imaj na umu da ta pisma \u010ditaju studenti organizatori pa za pismo nije po\u017eeljno da ima neki ozbiljan karakter.<b><\/b><\/p><p><b>\u0160to je validacija (ovjera) ra\u010duna?<\/b><br \/>To je potvrda tvog studentskog statusa. Nakon registracije korisni\u010dkog ra\u010duna radi prijave na seminare potrebno je i ovjeriti\u00a0(validirati)\u00a0ra\u010dun. Naime, svaki korisnik interneta se mo\u017ee prijaviti na seminar, ali ako nema potvr\u0111en studentski status, njegova prijava ne\u0107e biti valjana. Za validaciju potrebno je poslati lokalnoj BEST grupi potvrdu da si student (slika upisane godine u indexu ili potvrda sa fakulteta).<b><\/b><\/p><p><b>\u0160to zna\u010di \u2018Your account is not valid\u2019?<\/b><br \/>Tvoja prijava na seminare ne\u0107e biti valjana jer nema\u0161 potvr\u0111en status studenta.<b><\/b><\/p><p><b>Na koliko seminara se mogu prijaviti?<\/b><br \/>Po sezoni se mo\u017ee\u0161 prijaviti na 3 seminara, te ih poredati po prioritetu. Tijekom studija ukupno mo\u017ee\u0161 sudjelovati na 3 seminara.<b><\/b><\/p><p><b>Kako \u0107u znati jesam li primljen\/a?<\/b><br \/>Na slu\u017ebenim BEST-ovim stranicama, u\u00a0<a class=\"broken_link\" href=\"http:\/\/www.best.eu.org\/student\/private\/applying\/applicationManagement.jsp\">My applications<\/a>\u00a0nalaze se bitnije informacije o tvojoj prijavi. Tamo \u0107e pisati obavijest o statusu prijave.<\/p><\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<div id=\"elementor-tab-title-2423\" class=\"elementor-tab-title\" data-tab=\"3\" role=\"tab\" aria-controls=\"elementor-tab-content-2423\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-left\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"><\/i><\/span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"><\/i><\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" href=\"\">\u0160to me \u010deka na seminaru?<\/a>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t<div id=\"elementor-tab-content-2423\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"3\" role=\"tabpanel\" aria-labelledby=\"elementor-tab-title-2423\"><p><b>\u0160to napraviti kada sam primljen\/a na seminar?<\/b><br \/>Kontaktiraj\u00a0nas putem e-maila i dobit \u0107e\u0161 daljnja uputstva.<b><\/b><\/p><p><b>Kako do\u0107i do \u017eeljenog grada?<\/b><br \/>Na web stranicama pojedinog seminara nalazi se\u00a0Survival guide\u00a0u kojem su opisani na\u010dini dolaska, ovisno o transportnom sredstvu. Ako Survival guide nije dovoljno razumljiv, mo\u017ee\u0161 kontaktirati organizatore seminara za savjete. Dobit \u0107e\u0161 i kontakte ostalih sudionika seminara pa mo\u017ee\u0161 pitati i njih.<b><\/b><\/p><p><b>\u0160to je to \u2018International evening\u2019?<\/b><br \/>Na\u00a0International eveningu\u00a0studenti prezentiraju hranu i pi\u0107a koja su donijeli iz svoje dr\u017eave. To je ujedno i prilika za degustaciju dobara i iz drugih zemalja.<b><\/b><\/p><p><b>\u0160to je to \u2018city rally\u2019?<\/b><br \/>U sklopu seminara organizatori organiziraju i zabavno razgledavanje grada. Ono obi\u010dno uklju\u010duje i rje\u0161avanje nekih zabavnih zadataka na putu.<b><\/b><\/p><p><b>\u0160to je to \u2018pub crawling\u2019?<\/b><br \/>U sklopu seminara, jednu ve\u010der sudionici organizirano posje\u0107uju nekoliko lokalnih\u00a0pubova\u00a0i rje\u0161avaju zabavne zadatke.<\/p><\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<div id=\"elementor-tab-title-2424\" class=\"elementor-tab-title\" data-tab=\"4\" role=\"tab\" aria-controls=\"elementor-tab-content-2424\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-left\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"><\/i><\/span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"><\/i><\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" href=\"\">\u0160to nakon seminara?<\/a>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t<div id=\"elementor-tab-content-2424\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"4\" role=\"tabpanel\" aria-labelledby=\"elementor-tab-title-2424\"><p><b>Kako dobiti natrag polog (deposit)?<\/b><br \/>Ako si sudjelovao na predavanjima seminara, nisi napravio \u0161tetu i na vrijeme si ispunio anketu vezanu uz seminar nakon poha\u0111anja istoga, mo\u017ee\u0161 dobiti natrag polog (deposit). Kontaktiraj nas za daljnja uputstva.<b><\/b><\/p><p><b>Mogu li opet sudjelovati?<\/b><br \/>Svaki student tijekom studija ima pravo na seminarima sudjelovati 3 puta.<b><\/b><\/p><p><b>Kako dobiti ECTS bodove?<\/b><br \/>Na seminaru \u0107e\u0161 dobiti dokument koji potvr\u0111uje sudjelovanje te polo\u017eeni ispit. Na\u0161a preporuka jest kontaktirati ECTS koordinatora s pripadaju\u0107eg fakulteta.<\/p><\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>BEST Stru\u010dni seminari Op\u0107enito o BEST-ovim seminarima Odr\u017eavaju li se seminari kroz cijelu godinu? Da, seminari se odr\u017eavaju kroz \u010detiri sezone &#8211; godi\u0161nja doba (prolje\u0107e, ljeto, jesen i zima) te se studenti mogu prijaviti na seminare u sezoni koja trenutno traje. \u00a0 Koliko traju?Seminari traju izme\u0111u 7 i 14 dana. Gdje se odr\u017eavaju?Svaka lokalna BEST [&hellip;]<\/p>\n","protected":false},"author":5,"featured_media":0,"parent":15,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"elementor_header_footer","meta":{"footnotes":""},"class_list":["post-31","page","type-page","status-publish","hentry"],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v19.14 - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<title>FAQs - BEST Zagreb<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/best.hr\/seminari\/faqs\/\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"FAQs - BEST Zagreb\" \/>\n<meta property=\"og:description\" content=\"BEST Stru\u010dni seminari Op\u0107enito o BEST-ovim seminarima Odr\u017eavaju li se seminari kroz cijelu godinu? Da, seminari se odr\u017eavaju kroz \u010detiri sezone &#8211;